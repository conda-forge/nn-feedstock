   decode(t->tri[0], printtri);
   if (printtri.tri == m->dummytri) {
     fprintf(stderr, "    [0] = Outer space\n");
   } else {
-    fprintf(stderr, "    [0] = x%lx  %d\n", (unsigned long) printtri.tri,
