+    fprintf(stderr, "    [2] = x%zux  %d\n", (size_t) printtri.tri,
            printtri.orient);
   }
 
@@ -3566,38 +3566,38 @@ struct otri *t;
   if (printvertex == (vertex) NULL)
     fprintf(stderr, "    Origin[%d] = NULL\n", (t->orient + 1) % 3 + 3);
